---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { docPath, docSlugs, strings, type DocSlug, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  slug: DocSlug;
}

const { locale, slug } = Astro.props;
const t = strings[locale];
const entry = await getEntry('docs', `${locale}/${slug}`);
if (!entry) throw new Error(`Missing src/content/docs/${locale}/${slug}.md`);
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const path = `${slug}/`;
---

<Base locale={locale} path={path} title={`${entry.data.title} — AniShelf`} description={entry.data.description}>
  <SiteHeader locale={locale} path={path} />

  <main id="main" class="doc wrap">
    <header class="doc-head">
      <nav class="doc-nav" aria-label={t.docs.nav}>
        {
          docSlugs.map((s) => (
            <a href={docPath(locale, s)} aria-current={s === slug ? 'page' : undefined}>
              {t.footer[s]}
            </a>
          ))
        }
      </nav>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>

    <div class="doc-body">
      {
        sections.length > 2 && (
          <details class="toc">
            <summary class="mono">{t.docs.toc}</summary>
            <nav aria-label={t.docs.toc}>
              <ol>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }
      <article class="prose">
        <Content />
      </article>
    </div>
  </main>

  <SiteFooter locale={locale} path={path} />
</Base>

<style>
  .doc {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* ---------- Heading ---------- */

  .doc-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.1rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .doc-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  /* Each doc gets a spine color, like a volume on the landing page. */
  .doc-nav a {
    --spine: var(--spine-1);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--card) 70%, transparent);
    color: var(--ink-soft);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .doc-nav a:nth-child(2) {
    --spine: var(--spine-2);
  }

  .doc-nav a:nth-child(3) {
    --spine: var(--spine-4);
  }

  .doc-nav a::before {
    content: '';
    width: 4px;
    height: 1em;
    border-radius: 2px;
    background: var(--spine);
  }

  .doc-nav a:hover {
    color: var(--ink);
  }

  .doc-nav a[aria-current='page'] {
    border-color: transparent;
    background: var(--ink);
    color: var(--paper);
  }

  /* Japanese titles can be one long unbreakable phrase, so they get room to wrap. */
  h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    overflow-wrap: anywhere;
  }

  .lede {
    max-width: 40rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }

  /* ---------- Layout ---------- */

  .doc-body {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 1000px) {
    .doc-body {
      grid-template-columns: 13rem minmax(0, 46rem);
      gap: 4.5rem;
    }
  }

  /* ---------- Contents ---------- */

  .toc {
    align-self: start;
  }

  .toc summary {
    width: fit-content;
    padding-block: 0.75rem;
    color: var(--ink-faint);
    cursor: pointer;
  }

  .toc ol {
    display: grid;
    gap: 0.15rem;
    margin: 0.6rem 0 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--rule);
    list-style: none;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .toc a {
    display: block;
    padding-block: 0.3rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--ink);
  }

  @media (min-width: 1000px) {
    .toc {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }

    /* Always expanded beside the text; the script below keeps it open. */
    .toc summary {
      pointer-events: none;
      list-style: none;
    }

    .toc summary::-webkit-details-marker {
      display: none;
    }
  }

  /* ---------- Prose ---------- */

  .prose {
    min-width: 0;
    color: var(--ink-soft);
  }

  .prose :global(h2) {
    margin-top: 3.2rem;
    margin-bottom: 1rem;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.6vw, 1.95rem);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 2.2rem;
    margin-bottom: 0.6rem;
    color: var(--ink);
    font-size: 1.22rem;
    line-height: 1.3;
  }

  .prose :global(:is(p, ul, ol, blockquote)) {
    margin-block: 0 1rem;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4rem;
  }

  .prose :global(:is(ul, ol) :is(ul, ol)) {
    margin-top: 0.4rem;
    margin-bottom: 0;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(li::marker) {
    color: var(--apricot-deep);
  }

  .prose :global(ol > li::marker) {
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 620;
  }

  .prose :global(a) {
    color: var(--sky-deep);
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--paper-2);
    font-family: var(--font-mono);
    font-size: 0.82em;
    overflow-wrap: anywhere;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--apricot);
    border-radius: 0 14px 14px 0;
    background: var(--card);
    box-shadow: var(--shadow-1);
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prose :global(hr) {
    margin-block: 2.5rem;
    border: 0;
    border-top: 1px solid var(--rule);
  }
</style>

<script>
  // Keep the contents open beside the text on wide screens, collapsed above it
  // on narrow ones.
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  if (toc) {
    const wide = matchMedia('(min-width: 1000px)');
    const sync = () => (toc.open = wide.matches);
    sync();
    wide.addEventListener('change', sync);
  }
</script>
