---
import BrandLink from './BrandLink.astro';
import tmdbLogo from '../assets/badges/tmdb-short.svg';
import {
  BLOG_URL,
  CONTACT_EMAIL,
  GITHUB_URL,
  X_URL,
  docPath,
  docSlugs,
  localePath,
  strings,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  /** The current page below the locale root. Empty on the landing page. */
  path?: string;
}

const { locale, path = '' } = Astro.props;
const t = strings[locale];
const year = new Date().getFullYear();
---

<footer class="foot wrap">
  <div class="foot-row">
    <BrandLink href={path === '' ? '#main' : localePath(locale)} />
    <ul class="foot-links">
      {
        docSlugs.map((slug) => (
          <li>
            <a href={docPath(locale, slug)} aria-current={path === `${slug}/` ? 'page' : undefined}>
              {t.footer[slug]}
            </a>
          </li>
        ))
      }
      <li><a href={GITHUB_URL} rel="noopener">{t.footer.source}</a></li>
      <li><a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.contact}</a></li>
      <li><a href={X_URL} rel="noopener">X</a></li>
      <li><a href={BLOG_URL} rel="noopener">{t.footer.blog}</a></li>
    </ul>
  </div>
  <div class="legal">
    <a class="tmdb" href="https://www.themoviedb.org/" rel="noopener">
      <img src={tmdbLogo.src} alt={t.alt.tmdb} width="150" height="20" loading="lazy" />
    </a>
    <p>{t.footer.tmdb}</p>
    <p>{t.footer.apple}</p>
    <p>{t.footer.artwork}</p>
    <p>© {year} Samuel He</p>
  </div>
</footer>

<style>
  .foot {
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--rule);
  }

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem 2rem;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.93rem;
  }

  .foot-links a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .foot-links a[aria-current='page'] {
    color: var(--ink);
  }

  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .legal {
    display: grid;
    gap: 0.45rem;
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .tmdb {
    width: fit-content;
    margin-bottom: 0.5rem;
  }

  .tmdb img {
    width: 150px;
    height: auto;
  }
</style>
