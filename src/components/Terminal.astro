---
import { strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const comments = {
  en: ['Sign in to your iCloud library', 'Build the local snapshot', 'What am I watching?', 'Score breakdown, as JSON'],
  zh: ['登录你的 iCloud 资料库', '生成本地快照', '我在看什么？', '评分分布，输出为 JSON'],
  ja: ['iCloud のライブラリにサインイン', 'ローカルのスナップショットを作成', 'いま何を観てる？', 'スコアの内訳を JSON で'],
}[locale];

const lines: { comment: string; cmd: string }[] = [
  { comment: comments[0], cmd: 'ani auth login' },
  { comment: comments[1], cmd: 'ani lib init' },
  { comment: comments[2], cmd: 'ani lib list -w watching --sort updated' },
  { comment: comments[3], cmd: "ani lib stats --json | jq '.scores'" },
];
const t = strings[locale].volumes.terminal;
---

<figure class="term">
  <div class="bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <em>~ — ani</em>
  </div>
  <pre><code>{
    lines.map((l) => (
      <>
        <span class="c"># {l.comment}</span>
        {'\n'}
        <span class="p" aria-hidden="true">$ </span>
        {l.cmd}
        {'\n\n'}
      </>
    ))
  }<span class="p" aria-hidden="true">$ </span><span class="cursor" aria-hidden="true"></span></code></pre>
  <figcaption class="sr-only">{t.title}</figcaption>
</figure>

<style>
  .term {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: #0f1428;
    color: #e9e4d8;
    box-shadow:
      var(--shadow-2),
      0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0.7rem 0.9rem;
    background: #181e38;
  }

  .bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .bar span:nth-child(2) {
    background: #febc2e;
  }

  .bar span:nth-child(3) {
    background: #28c840;
  }

  .bar em {
    margin-inline: auto;
    padding-right: 40px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-style: normal;
    opacity: 0.55;
  }

  pre {
    margin: 0;
    padding: 1.2rem 1.3rem 1.4rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .c {
    color: #7f88a8;
    font-family: var(--font-mono), var(--cjk-sans);
  }

  .p {
    color: #f2a066;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: #6dbff2;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
