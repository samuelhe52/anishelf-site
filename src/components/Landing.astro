---
import Base from '../layouts/Base.astro';
import Phone from './Phone.astro';
import Tablet from './Tablet.astro';
import StoreBadge from './StoreBadge.astro';
import GitHubBadge from './GitHubBadge.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Petals from './Petals.astro';
import SkyScene from './SkyScene.astro';
import Shelf from './Shelf.astro';
import ReminderMock from './ReminderMock.astro';
import ReminderSettings from './ReminderSettings.astro';
import ExportFormats from './ExportFormats.astro';
import Terminal from './Terminal.astro';
import Phrases from './Phrases.astro';
import CopyButton from './CopyButton.astro';

import BrandIcon from './BrandIcon.astro';
import { screens } from '../assets/screens';

import {
  CLI_SKILL_URL,
  CLI_URL,
  CLI_VERSION,
  TESTFLIGHT_URL,
  strings,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const v = t.volumes;
const ids = ['collect', 'track', 'remind', 'reflect', 'sync', 'terminal'];
const label = (n: number) => t.volumeLabel(n);
const install = `uv tool install --python 3.13 git+https://github.com/samuelhe52/anishelf-cli.git@${CLI_VERSION}`;
---

<Base locale={locale}>
  <SiteHeader locale={locale} />

  <main id="main">
    <!-- Hero -->
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="mono kicker rise" style="--i:1"><span class="dot" aria-hidden="true"></span>{t.hero.kicker}</p>
        <h1 class="rise" style="--i:2">
          {t.hero.titleLines.map((line, i) => <span class:list={['line', { accent: i === 1 }]}><Phrases text={line} /></span>)}
        </h1>
        <p class="lede rise" style="--i:3">{t.hero.lede}</p>
        <div class="cta rise" style="--i:4">
          <span class="stores">
            <StoreBadge locale={locale} />
            <GitHubBadge locale={locale} />
          </span>
          <a class="tf" href={TESTFLIGHT_URL} rel="noopener">{t.hero.testflight}<span aria-hidden="true">&nbsp;→</span></a>
        </div>
        <ul class="facts mono rise" style="--i:5">
          {t.hero.facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="hero-stage">
        <div class="hero-sky">
          <SkyScene seed={7} stars={60} />
          <div class="hero-moon" aria-hidden="true"></div>
        </div>
        <Petals count={14} fade="edges" />
        <div class="hero-devices">
          <Phone class="hp hp-left" {...screens.detail} alt={t.alt.detail} sizes="(min-width: 960px) 210px, 34vw" eager />
          <Phone class="hp hp-right" {...screens.stats} alt={t.alt.stats} sizes="(min-width: 960px) 200px, 32vw" eager />
          <Phone class="hp hp-center" {...screens.grid} alt={t.alt.grid} sizes="(min-width: 960px) 250px, 40vw" eager />
        </div>
        <div class="hero-plank" aria-hidden="true"></div>
      </div>
    </section>

    <Shelf locale={locale} ids={ids} />

    <!-- Vol. 01 — Collect -->
    <section class="vol" id={ids[0]} aria-labelledby={`${ids[0]}-title`}>
      <div class="wrap vol-grid">
        <div class="vol-copy reveal">
          <p class="mono vol-label"><b>{label(1)}</b><i></i>{v.collect.spine}</p>
          <h2 id={`${ids[0]}-title`}><Phrases text={v.collect.title} /></h2>
          <p class="body">{v.collect.body}</p>
          <ul class="points">{v.collect.points?.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="trio">
          <Phone class="t1" {...screens.list} alt={t.alt.list} sizes="(min-width: 960px) 220px, 30vw" />
          <Phone class="t2" {...screens.grid} alt={t.alt.grid} sizes="(min-width: 960px) 240px, 34vw" />
          <Phone class="t3" {...screens.gallery} alt={t.alt.featured} sizes="(min-width: 960px) 220px, 30vw" />
        </div>
      </div>
    </section>

    <!-- Vol. 02 — Track -->
    <section class="vol vol-tint" id={ids[1]} aria-labelledby={`${ids[1]}-title`}>
      <div class="wrap vol-grid flip">
        <div class="vol-copy reveal">
          <p class="mono vol-label"><b>{label(2)}</b><i></i>{v.track.spine}</p>
          <h2 id={`${ids[1]}-title`}><Phrases text={v.track.title} /></h2>
          <p class="body">{v.track.body}</p>
          <div class="statuses" role="list">
            {
              [0, 2].map((start) => (
                <span class="pair">
                  {v.track.statuses.slice(start, start + 2).map((s, i) => (
                    <span role="listitem" data-status={start + i}>
                      {s}
                    </span>
                  ))}
                </span>
              ))
            }
          </div>
        </div>
        <div class="duo">
          <Phone class="d1" {...screens.detail} alt={t.alt.detail} sizes="(min-width: 960px) 250px, 42vw" />
          <Phone class="d2" {...screens.manage} alt={t.alt.manage} sizes="(min-width: 960px) 250px, 42vw" />
        </div>
      </div>
    </section>

    <!-- Vol. 03 — Remind -->
    <section class="vol" id={ids[2]} aria-labelledby={`${ids[2]}-title`}>
      <div class="wrap vol-grid">
        <div class="vol-copy reveal">
          <p class="mono vol-label"><b>{label(3)}</b><i></i>{v.remind.spine}</p>
          <h2 id={`${ids[2]}-title`}><Phrases text={v.remind.title} /></h2>
          <p class="body">{v.remind.body}</p>
          <p class="fine">{v.remind.source}</p>
        </div>
        <div class="remind-stage">
          <ReminderMock class="lock-phone" locale={locale} />
          <ReminderSettings class="lock-card" locale={locale} />
        </div>
      </div>
    </section>

    <!-- Vol. 04 — Reflect -->
    <section class="vol vol-tint" id={ids[3]} aria-labelledby={`${ids[3]}-title`}>
      <div class="wrap vol-grid flip">
        <div class="vol-copy reveal">
          <p class="mono vol-label"><b>{label(4)}</b><i></i>{v.reflect.spine}</p>
          <h2 id={`${ids[3]}-title`}><Phrases text={v.reflect.title} /></h2>
          <p class="body">{v.reflect.body}</p>
        </div>
        <div class="reflect-stage">
          <Tablet class="rt" {...screens.ipadStats} alt={t.alt.ipadStats} sizes="(min-width: 960px) 560px, 80vw" />
          <Phone class="rp" {...screens.stats} alt={t.alt.stats} sizes="(min-width: 960px) 190px, 32vw" />
        </div>
      </div>
    </section>

    <!-- Vol. 05 — Sync -->
    <section class="vol" id={ids[4]} aria-labelledby={`${ids[4]}-title`}>
      <div class="wrap sync">
        <div class="sync-head reveal">
          <p class="mono vol-label"><b>{label(5)}</b><i></i>{v.everywhere.spine}</p>
          <h2 id={`${ids[4]}-title`}><Phrases text={v.everywhere.title} /></h2>
          <p class="body">{v.everywhere.body}</p>
        </div>
        <Tablet class="sync-tablet" {...screens.ipadGrid} alt={t.alt.ipadGrid} sizes="(min-width: 1240px) 1100px, 92vw" />
        <div class="sync-foot">
          <ul class="points">{v.everywhere.points?.map((p) => <li>{p}</li>)}</ul>
          <ExportFormats label={v.everywhere.exportLabel} />
        </div>
      </div>
    </section>

    <!-- Vol. 06 — Terminal -->
    <section class="vol vol-tint" id={ids[5]} aria-labelledby={`${ids[5]}-title`}>
      <div class="wrap vol-grid">
        <div class="vol-copy reveal">
          <p class="mono vol-label"><b>{label(6)}</b><i></i>{v.terminal.spine}</p>
          <h2 id={`${ids[5]}-title`}><Phrases text={v.terminal.title} /></h2>
          <p class="body">{v.terminal.body}</p>
          <p class="fine">{v.terminal.readOnly}</p>
          <p class="links-row">
            <a href={CLI_URL} rel="noopener">anishelf-cli<span aria-hidden="true">&nbsp;↗</span></a>
            <a href={CLI_SKILL_URL} rel="noopener">SKILL.md<span aria-hidden="true">&nbsp;↗</span></a>
          </p>
          <p class="fine agents">{v.terminal.agents}</p>
        </div>
        <div class="term-stage">
          <p class="mono install-label" id="install-label">{v.terminal.install}</p>
          <div class="install">
            <code>{install}</code>
            <CopyButton text={install} label={v.terminal.copy} done={v.terminal.copied} describedby="install-label" />
          </div>
          <Terminal locale={locale} />
        </div>
      </div>
    </section>

    <!-- Good to know -->
    <section class="notes wrap" id="notes" aria-labelledby="notes-title">
      <h2 id="notes-title" class="reveal">{t.notes.title}</h2>
      <ol>
        {
          t.notes.items.map((n, i) => (
            <li class="reveal">
              <span class="stamp" aria-hidden="true">{i + 1}</span>
              <h3>{n.title}</h3>
              <p>{n.body}</p>
              {n.link && (
                <a href={n.link.href} rel={n.link.href.startsWith('/') ? undefined : 'noopener'}>
                  {n.link.label}
                  <span aria-hidden="true">&nbsp;{n.link.href.startsWith('/') ? '→' : '↗'}</span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Outro -->
    <section class="outro wrap" id="download" aria-labelledby="outro-title">
      <div class="sky">
        <SkyScene seed={23} />
        <Petals count={8} seed={23} />
        <div class="halo">
          <BrandIcon class="outro-icon" size={168} alt={t.alt.icon} lazy />
        </div>
        <h2 id="outro-title"><Phrases text={t.outro.title} /></h2>
        <p>{t.outro.body}</p>
        <div class="cta">
          <span class="stores">
            <StoreBadge locale={locale} height={58} />
            <GitHubBadge locale={locale} height={58} />
          </span>
        </div>
        <a class="tf" href={TESTFLIGHT_URL} rel="noopener">{t.outro.testflight}<span aria-hidden="true">&nbsp;→</span></a>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>

<style>
  /* ---------- Hero ---------- */

  /* The hero sky bleeds past the column; keep it from widening the page. */
  main {
    overflow-x: clip;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw + 1rem, 5.5rem) clamp(4rem, 9vw, 7rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
    color: var(--ink-soft);
  }

  .dot {
    width: 8px;
    height: 12px;
    border-radius: 85% 0 85% 0;
    background: var(--sky);
  }

  h1 {
    font-size: clamp(3rem, 6.6vw, 5.9rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  :lang(zh) h1,
  :lang(ja) h1 {
    font-size: clamp(2.4rem, 5.2vw, 4.4rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .line {
    display: block;
  }

  .accent {
    color: var(--apricot-deep);
    font-style: italic;
    font-weight: 480;
  }

  :lang(zh) .accent,
  :lang(ja) .accent {
    font-style: normal;
    font-weight: inherit;
  }

  .lede {
    max-width: 34rem;
    margin-top: 1.8rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--ink-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.2rem;
  }

  .stores {
    display: inline-flex;
    gap: 0.75rem;
  }

  .tf {
    font-weight: 560;
    color: var(--sky-deep);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--sky) 40%, transparent);
    padding-bottom: 2px;
  }

  .tf:hover {
    border-bottom-color: var(--sky);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 2.2rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-faint);
  }

  .facts li::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 11px;
    margin-right: 0.55rem;
    border-radius: 85% 0 85% 0;
    background: var(--apricot);
    vertical-align: -1px;
  }

  :lang(zh) .facts,
  :lang(ja) .facts {
    font-family: var(--cjk-sans);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }

  .hero-stage {
    position: relative;
    aspect-ratio: 1 / 1.02;
    max-height: 690px;
    isolation: isolate;
  }

  /* Day or night sky behind the phones, echoing the app icon. */
  .hero-sky {
    position: absolute;
    inset: 4% -6% 3% 2%;
    z-index: -2;
    isolation: isolate;
    border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  /* Sun by day, moon by night, with the faint rings of a halo. */
  .hero-moon {
    position: absolute;
    top: 9%;
    right: 15%;
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 45%, #fffaf0);
    box-shadow:
      0 0 0 1.4rem rgb(255 255 255 / 0.2),
      0 0 0 3.2rem rgb(255 255 255 / 0.1),
      0 0 90px 40px rgb(255 255 255 / 0.6);
  }

  @media (prefers-color-scheme: dark) {
    .hero-moon {
      background: radial-gradient(circle at 36% 34%, #fff4dc, #f6d9a6 55%, #d9b27a);
      box-shadow:
        inset -10px -8px 18px rgb(120 80 60 / 0.35),
        0 0 0 1.4rem rgb(246 201 143 / 0.07),
        0 0 0 3.2rem rgb(246 201 143 / 0.035),
        0 0 60px 18px rgb(246 201 143 / 0.28);
    }
  }

  /*
   * The hero has no frame for petals to fall out of, so start them above the
   * stage and let them fade in from thin air.
   */
  .hero-stage :global(.petals) {
    inset: -14% 0 4%;
  }

  /* The phones stand in the plank: nothing shows below its top edge. */
  .hero-devices {
    position: absolute;
    inset: 0;
    clip-path: inset(-30% -30% 4% -30%);
  }

  .hero-stage :global(.hp) {
    position: absolute;
    bottom: 4%;
  }

  .hero-stage :global(.hp-center) {
    left: 31%;
    width: 39%;
    z-index: 3;
    animation: rise 1.1s var(--ease-out) 0.25s both;
  }

  .hero-stage :global(.hp-left) {
    left: 3%;
    width: 33%;
    z-index: 2;
    transform-origin: bottom right;
    rotate: -7deg;
    animation: rise 1.1s var(--ease-out) 0.4s both;
  }

  .hero-stage :global(.hp-right) {
    right: 0;
    width: 31%;
    z-index: 1;
    transform-origin: bottom left;
    rotate: 5deg;
    animation: rise 1.1s var(--ease-out) 0.55s both;
  }

  .hero-plank {
    position: absolute;
    left: -4%;
    right: -6%;
    bottom: calc(4% - 12px);
    z-index: 4;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(180deg, color-mix(in oklab, var(--ink) 70%, var(--apricot)) 0 3px, var(--ink) 3px);
    box-shadow: 0 18px 26px -12px rgb(23 32 58 / 0.5);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-stage {
      width: min(100%, 560px);
      margin-inline: auto;
    }
  }

  /* Keep the fanned phones, sky, and plank clear of the screen edges. */
  @media (max-width: 600px) {
    .hero-stage::before {
      inset-inline: 3% -2%;
    }

    .hero-devices {
      inset-inline: 4%;
    }

    .hero-plank {
      left: -2%;
      right: -2%;
    }
  }

  /* ---------- Volumes ---------- */

  .vol {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .vol-tint {
    background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--paper-2) 70%, transparent) 12%, color-mix(in oklab, var(--paper-2) 70%, transparent) 88%, transparent);
  }

  .vol-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
  }

  .vol-grid.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .vol-grid.flip > .vol-copy {
    order: 2;
  }

  .vol-label {
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
    color: var(--ink-soft);
  }

  :lang(zh) .vol-label,
  :lang(ja) .vol-label {
    font-family: var(--font-mono), var(--cjk-sans);
    letter-spacing: 0.14em;
  }

  .vol-label b {
    color: var(--apricot-deep);
    font-weight: 600;
  }

  .vol-label i {
    flex: 0 0 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  h2 {
    font-size: clamp(2.2rem, 4.2vw, 3.5rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 120;
  }

  :lang(zh) h2,
  :lang(ja) h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
  }

  .body {
    max-width: 32rem;
    margin-top: 1.4rem;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .fine {
    max-width: 32rem;
    margin-top: 1.2rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  .points {
    display: grid;
    gap: 0.75rem;
    max-width: 32rem;
    margin: 1.8rem 0 0;
    padding: 1.4rem 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .points li {
    position: relative;
    padding-left: 1.5rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 12px;
    border-radius: 85% 0 85% 0;
    background: var(--sky);
  }

  @media (max-width: 860px) {
    .vol-grid,
    .vol-grid.flip {
      grid-template-columns: 1fr;
    }

    .vol-grid.flip > .vol-copy {
      order: 0;
    }
  }

  /* Vol. 01: three phones fanned like a hand of cards. */
  .trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 0;
    padding-inline: 4%;
  }

  .trio :global(.t1) {
    rotate: -5deg;
    translate: 12% 4%;
  }

  .trio :global(.t2) {
    z-index: 2;
    scale: 1.1;
    translate: 0 -6%;
  }

  .trio :global(.t3) {
    rotate: 5deg;
    translate: -12% 4%;
  }

  /* Dealt out from under the middle card as the section scrolls in. */
  @supports (animation-timeline: view()) {
    .trio :global(:is(.t1, .t3)) {
      animation: deal linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }

    .trio :global(.t1) {
      --deal: 88%;
    }

    .trio :global(.t3) {
      --deal: -88%;
    }
  }

  @keyframes deal {
    from {
      rotate: 0deg;
      translate: var(--deal) 0;
    }
  }

  /* Vol. 02 */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6%;
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .duo :global(.d2) {
    translate: 0 12%;
  }

  /* Chips wrap in pairs, so a narrow column gets 2 + 2 rather than 3 + 1. */
  .statuses,
  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .statuses {
    margin-top: 1.8rem;
  }

  .statuses [role='listitem'] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--rule);
    font-size: 0.92rem;
    font-weight: 560;
  }

  .statuses [role='listitem']::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-sizing: border-box;
  }

  .statuses [data-status='0']::before {
    border: 1.5px solid var(--ink-faint);
  }

  .statuses [data-status='1']::before {
    background: #f08a2c;
  }

  .statuses [data-status='2']::before {
    background: #34b45a;
  }

  .statuses [data-status='3']::before {
    background: var(--ink-faint);
  }

  /* Vol. 03 */
  .remind-stage {
    position: relative;
    padding-block: 1rem;
  }

  /* The phone sits right of center so the timing menu can lean against it. */
  .remind-stage :global(.lock-phone) {
    width: min(62%, 320px);
    margin-inline: auto 6%;
  }

  .remind-stage :global(.lock-card) {
    position: absolute;
    top: 50%;
    right: calc(6% + min(62%, 320px) - 2.5rem);
    z-index: 1;
    width: min(52%, 17rem);
    rotate: -3deg;
    translate: 0 -72%;
  }

  /* Slides out from behind the phone as the section scrolls in. */
  @supports (animation-timeline: view()) {
    .remind-stage :global(.lock-card) {
      animation: slip linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 100%;
    }
  }

  @keyframes slip {
    from {
      rotate: 0deg;
      translate: 45% -72%;
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .remind-stage :global(.lock-phone) {
      width: min(78%, 320px);
      margin-inline: auto 2%;
    }

