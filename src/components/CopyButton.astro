---
interface Props {
  /** Text to put on the clipboard. */
  text: string;
  label: string;
  /** Shown and announced after a successful copy. */
  done: string;
  /** ID of the element that says what gets copied. */
  describedby?: string;
}

const { text, label, done, describedby } = Astro.props;
---

<button class="copy" type="button" data-copy={text} aria-describedby={describedby}>
  <span class="stack" aria-hidden="true">
    <svg class="idle" viewBox="0 0 16 16">
      <rect x="5.25" y="5.25" width="8" height="8" rx="2" />
      <path d="M10.75 3.25a1.5 1.5 0 0 0-1.5-1.5h-5a2 2 0 0 0-2 2v5a1.5 1.5 0 0 0 1.5 1.5" />
    </svg>
    <svg class="ok" viewBox="0 0 16 16">
      <path d="m3.25 8.5 3 3 6.5-7" />
    </svg>
  </span>
  <!-- Both labels share one cell, so the button keeps its width. -->
  <span class="stack labels">
    <span class="idle">{label}</span>
    <span class="ok">{done}</span>
  </span>
</button>
<span class="sr-only" role="status"></span>

<script>
  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
      const status = button.nextElementSibling;
      let timer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          // No clipboard access: select the command so it can be copied by hand.
          const code = button.parentElement?.querySelector('code');
          if (code) getSelection()?.selectAllChildren(code);
          return;
        }
        button.dataset.state = 'done';
        if (status) status.textContent = button.querySelector('.labels .ok')?.textContent ?? '';
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete button.dataset.state;
          if (status) status.textContent = '';
        }, 2000);
      });
    }
  });
</script>

<style>
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem 0.4rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-soft);
    font: 560 0.8rem / 1.2 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out);
  }

  .copy:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--ink) 35%, transparent);
  }

  .copy:active {
    transform: scale(0.96);
  }

  .copy[data-state='done'] {
    color: var(--sky-deep);
    border-color: color-mix(in oklab, var(--sky) 45%, transparent);
  }

  .stack {
    display: grid;
  }

  .stack > * {
    grid-area: 1 / 1;
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* visibility also keeps the hidden label out of the button's name. */
  .ok,
  [data-state='done'] .idle {
    visibility: hidden;
  }

  [data-state='done'] .ok {
    visibility: visible;
  }

  /* Icon only on phones, where the command takes the width. */
  @media (max-width: 480px) {
    .copy {
      padding: 0.45rem;
    }

    .labels {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
