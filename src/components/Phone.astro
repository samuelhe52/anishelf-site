---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
  style?: string;
}

const { src, alt, sizes, eager = false, class: className, style } = Astro.props;
---

<figure class:list={['phone', className]} style={style}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[320, 480, 720, 1000]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

<style>
  .phone {
    margin: 0;
    aspect-ratio: 1206 / 2622;
    padding: 2.6%;
    background: var(--bezel);
    /* Elliptical radii keep the corners circular on a 1:2.17 box. */
    border-radius: 15% / 6.9%;
    box-shadow:
      var(--shadow-2),
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14);
  }

  .phone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12.6% / 5.8%;
  }
</style>
