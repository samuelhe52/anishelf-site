---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Common {
  class?: string;
  style?: string;
}

/** A screenshot on the display. */
interface Shot extends Common {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}

/** Custom display content from the default slot, laid out in `cqw` units. */
interface Custom extends Common {
  src?: never;
}

type Props = Shot | Custom;

const props = Astro.props;
---

<figure class:list={['phone', props.class]} style={props.style}>
  <div class="screen">
    {
      props.src ? (
        <Picture
          src={props.src}
          alt={props.alt}
          formats={['avif', 'webp']}
          widths={[320, 480, 720, 1000]}
          sizes={props.sizes}
          loading={props.eager ? 'eager' : 'lazy'}
          fetchpriority={props.eager ? 'high' : 'auto'}
          decoding="async"
        />
      ) : (
        <slot />
      )
    }
  </div>
</figure>

<style>
  /*
   * iPhone 16 Pro proportions, in screenshot pixels: the 1206×2622 display has
   * 186px (62pt) corners and sits inside a 44px border, an 18px metal band
   * plus 26px of black glass. Every value below is that geometry as a share of
   * the phone's own box, so the frame scales freely and never crops the shot.
   */
  .phone {
    position: relative;
    margin: 0;
    aspect-ratio: 1294 / 2710;
    border-radius: 17.77% / 8.49%;
    background: var(--device-band);
    box-shadow:
      var(--shadow-2),
      inset 0 0 0 1px var(--device-edge);
  }

  /* Black glass around the display. */
  .phone::before {
    content: '';
    position: absolute;
    inset: 0.66% 1.39%;
    border-radius: 16.85% / 7.93%;
    background: var(--bezel);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
  }

  /* Action and volume buttons on the left, the side button on the right. */
  .phone::after {
    content: '';
    position: absolute;
    inset: 0 -0.85%;
    background:
      linear-gradient(
          transparent 20.1%,
          var(--device-key) 20.1% 25.4%,
          transparent 25.4% 28.7%,
          var(--device-key) 28.7% 38.1%,
          transparent 38.1% 39.4%,
          var(--device-key) 39.4% 48.8%,
          transparent 48.8%
        )
        left / 0.84% 100% no-repeat,
      linear-gradient(transparent 30.1%, var(--device-key) 30.1% 44.8%, transparent 44.8%) right / 0.84% 100%
        no-repeat;
    pointer-events: none;
  }

  .screen {
    position: absolute;
    inset: 1.62% 3.4%;
    overflow: clip;
    border-radius: 15.42% / 7.09%;
    background: #000;
    container-type: size;
  }

  .screen :global(picture) {
    display: block;
    height: 100%;
  }

  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dynamic Island: 126×37pt, 11pt from the top. */
  .screen::after {
    content: '';
    position: absolute;
    top: 1.26%;
    left: 34.33%;
    width: 31.34%;
    height: 4.27%;
    border-radius: 999px;
    background: #000;
  }
</style>
