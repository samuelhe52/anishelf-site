---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { src, alt, sizes, class: className } = Astro.props;
---

<figure class:list={['tablet', className]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1400, 2000]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .tablet {
    margin: 0;
    aspect-ratio: 2752 / 2064;
    padding: 1.7%;
    background: var(--bezel);
    border-radius: 4.6% / 6.1%;
    box-shadow:
      var(--shadow-2),
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14);
  }

  .tablet :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3.2% / 4.3%;
  }
</style>
