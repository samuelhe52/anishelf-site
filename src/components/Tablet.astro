---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { src, alt, sizes, class: className } = Astro.props;
---

<figure class:list={['tablet', className]}>
  <div class="screen">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1400, 2000]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
  </div>
</figure>

<style>
  /*
   * 13-inch iPad Pro in landscape, in screenshot pixels: the 2752×2064 display
   * has 54px corners and sits inside an 88px border, a 14px metal band plus
   * 74px of black glass, with the front camera centered in the top bezel.
   */
  .tablet {
    position: relative;
    margin: 0;
    aspect-ratio: 2928 / 2240;
    border-radius: 4.85% / 6.34%;
    background: var(--device-band);
    box-shadow:
      var(--shadow-2),
      inset 0 0 0 1px var(--device-edge);
  }

  /* Black glass around the display. */
  .tablet::before {
    content: '';
    position: absolute;
    inset: 0.63% 0.48%;
    border-radius: 4.41% / 5.79%;
    background: var(--bezel);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
  }

  /* Front camera. */
  .tablet::after {
    content: '';
    position: absolute;
    top: 1.65%;
    left: 50%;
    width: 0.96%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% 0;
    background: radial-gradient(circle at 35% 35%, #3b4663 0 14%, #151b2c 34%, #06080e 72%);
  }

  .screen {
    position: absolute;
    inset: 3.93% 3.01%;
    overflow: clip;
    border-radius: 1.96% / 2.62%;
    background: #000;
  }

  .screen :global(picture) {
    display: block;
    height: 100%;
  }

  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
