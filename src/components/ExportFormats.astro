---
interface Props {
  label: string;
}

const { label } = Astro.props;
const formats = ['TXT', 'CSV', 'TSV', 'JSON', 'XLSX'];
---

<div class="formats">
  <span class="mono">{label}</span>
  <ul>
    {formats.map((f, i) => <li style={`--i:${i}`}>.{f.toLowerCase()}</li>)}
  </ul>
</div>

<style>
  .formats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .formats .mono {
    color: var(--ink-faint);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 0.45rem 0.8rem 0.45rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px 12px 4px 4px;
    background: var(--card);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    box-shadow: var(--shadow-1);
    transform: rotate(calc((var(--i) - 2) * 0.8deg));
  }

  /* Folded corner, like a file icon. */
  li::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 10px;
    height: 10px;
    border-radius: 0 12px 0 3px;
    background: linear-gradient(225deg, var(--paper) 50%, var(--paper-2) 50%);
    border-left: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
</style>
