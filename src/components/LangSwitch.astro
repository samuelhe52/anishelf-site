---
import { htmlLang, localeName, localeShort, locales, pagePath, strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** The current page below the locale root, so switching keeps the same page. */
  path?: string;
}

const { locale, path = '' } = Astro.props;
---

<nav class="lang" aria-label={strings[locale].nav.language}>
  {
    locales.map((l) => (
      <a
        href={pagePath(l, path)}
        hreflang={htmlLang[l]}
        lang={htmlLang[l]}
        aria-current={l === locale ? 'page' : undefined}
        title={localeName[l]}
      >
        <span aria-hidden="true">{localeShort[l]}</span>
        <span class="sr-only">{localeName[l]}</span>
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--card) 70%, transparent);
  }

  .lang a {
    min-width: 2.1rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    color: var(--ink-soft);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .lang a[lang='zh-Hans'],
  .lang a[lang='ja'] {
    font-family: var(--cjk-sans);
    font-size: 0.78rem;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Open the other language at the section being read, not the top. Doc
    // headings use the same ids in every locale.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang a[hreflang]')) {
      link.addEventListener('click', () => {
        const line = innerHeight * 0.3;
        let current = '';
        for (const section of document.querySelectorAll('main > [id], .prose > h2[id]')) {
          if (section.getBoundingClientRect().top > line) break;
          current = section.id;
        }
        link.hash = current;
      });
    }
  });
</script>
