---
import { htmlLang, localeName, localeShort, locales, pagePath, strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** The current page below the locale root, so switching keeps the same page. */
  path?: string;
}

const { locale, path = '' } = Astro.props;
---

<nav class="lang" aria-label={strings[locale].nav.language}>
  {
    locales.map((l) => (
      <a
        href={pagePath(l, path)}
        hreflang={htmlLang[l]}
        lang={htmlLang[l]}
        aria-current={l === locale ? 'page' : undefined}
        title={localeName[l]}
      >
        <span aria-hidden="true">{localeShort[l]}</span>
        <span class="sr-only">{localeName[l]}</span>
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--card) 70%, transparent);
  }

  .lang a {
    min-width: 2.1rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    color: var(--ink-soft);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .lang a[lang='zh-Hans'],
  .lang a[lang='ja'] {
    font-family: var(--cjk-sans);
    font-size: 0.78rem;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  // Fetch the other languages' pages and their stylesheets ahead of time, so a
  // tap switches at once. Touch screens have no hover to trigger Astro's
  // prefetch, and the CJK font CSS would otherwise load only after the page.
  const warmed = new Map<string, Promise<string | null>>();
  // Resolves once the stylesheets `next` adds to this page have loaded.
  const loadStyles = (next: Document) =>
    Promise.all(
      Array.from(next.querySelectorAll<HTMLLinkElement>('head link[rel=stylesheet]'))
        .filter((link) => !document.querySelector(`link[rel=stylesheet][href="${link.getAttribute('href')}"]`))
        .map((link) => new Promise((resolve) => {
          const preload = Object.assign(document.createElement('link'), { rel: 'preload', as: 'style', href: link.href });
          preload.onload = preload.onerror = resolve;
          document.head.append(preload);
        })),
    );
  const warm = (url: string) => {
    if (warmed.has(url)) return;
    const page = fetch(url)
      .then((res) => (res.ok && res.headers.get('content-type')?.startsWith('text/html') ? res.text() : null))
      .then(async (html) => {
        if (html) await loadStyles(new DOMParser().parseFromString(html, 'text/html'));
        return html;
      })
      .catch(() => null);
    warmed.set(url, page);
  };

  document.addEventListener('astro:before-preparation', (event) => {
    const page = warmed.get(event.to.pathname);
    if (!page || event.formData) return;
    const loader = event.loader;
    event.loader = async () => {
      const html = await page;
      if (!html || event.signal.aborted) return loader();
      event.newDocument = new DOMParser().parseFromString(html, 'text/html');
      event.newDocument.querySelectorAll('noscript').forEach((el) => el.remove());
      await loadStyles(event.newDocument);
    };
  });

  document.addEventListener('astro:page-load', () => {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (!connection?.saveData) {
      const idle = window.requestIdleCallback ?? ((callback: () => void) => setTimeout(callback, 200));
      idle(() => {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang a:not([aria-current])')) {
          warm(new URL(link.href).pathname);
        }
      });
    }

    // Open the other language at the section being read, not the top. Doc
    // headings use the same ids in every locale.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang a[hreflang]')) {
      link.addEventListener('click', () => {
        const line = innerHeight * 0.3;
        let current = '';
        for (const section of document.querySelectorAll('main > [id], .prose > h2[id]')) {
          if (section.getBoundingClientRect().top > line) break;
          current = section.id;
        }
        link.hash = current;
      });
    }
  });
</script>
