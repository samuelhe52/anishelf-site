---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Shown instead of `src` when the visitor prefers a dark color scheme. */
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
}

const { src, dark, alt, widths, sizes, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;

/*
 * AVIF's scale runs lower than WebP/JPEG's, so it gets a lower number for a
 * similar look. Hero images (fetchpriority high) get a higher AVIF number.
 */
const quality = fetchpriority === 'high' ? { avif: 70, webp: 85, jpg: 85 } : { avif: 64, webp: 85, jpg: 85 };

/*
 * Astro's <Picture> can't put a media query on its sources, so this builds the
 * same AVIF → WebP → JPEG ladder per theme. The browser takes the first
 * matching source, so it downloads only the screenshot for the active theme.
 */
const ladder = (image: ImageMetadata) =>
  Promise.all(
    (['avif', 'webp', 'jpg'] as const).map(async (format) => ({
      image: await getImage({ src: image, format, widths, sizes, quality: quality[format] }),
      type: `image/${format === 'jpg' ? 'jpeg' : format}`,
    })),
  );

const sources = [
  ...(dark ? (await ladder(dark)).map((s) => ({ ...s, media: '(prefers-color-scheme: dark)' })) : []),
  ...(await ladder(src)).map((s) => ({ ...s, media: undefined })),
];
const fallback = sources.at(-1)!.image;
---

<picture>
  {sources.slice(0, -1).map((s) => <source srcset={s.image.srcSet.attribute} type={s.type} media={s.media} sizes={sizes} />)}
  <img
    src={fallback.src}
    srcset={fallback.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={fallback.attributes.width}
    height={fallback.attributes.height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
