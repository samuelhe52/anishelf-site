---
import { GITHUB_URL, strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Matches the App Store badge it sits beside. */
  height?: number;
}

const { locale, height = 54 } = Astro.props;
---

<a class="gh" href={GITHUB_URL} rel="noopener" title={strings[locale].footer.source} style={`--h:${height}px`}>
  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
    <path
      fill="currentColor"
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
  <span>GitHub</span>
</a>

<style>
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--h);
    padding: 0 1.1rem;
    border: 1px solid color-mix(in oklab, currentColor 28%, transparent);
    border-radius: 10px;
    color: var(--ink-soft);
    font-weight: 560;
    text-decoration: none;
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .gh:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, currentColor 55%, transparent);
    color: var(--ink);
  }
</style>
