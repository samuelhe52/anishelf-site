---
import { strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const c = strings[locale].volumes.remind.card;

// Same shows as the Lock Screen. The mockup's clock reads Saturday, August 8,
// 23:15, so さよならララ airs in 15 minutes and the others return next week.
const shows = [
  { title: 'さよならララ', airs: '2026-08-08T23:30:00Z' },
  { title: 'スーパーの裏でヤニ吸うふたり', airs: '2026-08-14T23:45:00Z' },
  { title: 'きみが死ぬまで恋をしたい', airs: '2026-08-15T21:15:00Z' },
];

const dateLocale = { en: 'en-US', zh: 'zh-CN', ja: 'ja-JP' }[locale];
const when = new Intl.DateTimeFormat(dateLocale, {
  month: locale === 'en' ? 'short' : 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
  timeZone: 'UTC',
});
---

<div
  class:list={['card', className]}
  role="img"
  aria-label={`${c.title}. ${c.remindMe}: ${c.timing}. ${c.manage}: ${shows.map((s) => s.title).join(', ')}.`}
>
  <div class="head" aria-hidden="true">
    <span class="tile">
      <svg viewBox="0 0 24 24"><use href="#bell-badge" /></svg>
    </span>
    <div>
      <strong>{c.title}</strong>
      <p>{c.subtitle}</p>
    </div>
  </div>

  <div class="remind" aria-hidden="true">
    <span>{c.remindMe}</span>
    <span class="pill">
      {c.timing}
      <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5" /></svg>
    </span>
  </div>

  <div class="manage" aria-hidden="true">
    <p class="manage-title">
      <svg viewBox="0 0 24 24"><use href="#bell-badge" /></svg>
      {c.manage}
    </p>
    <ul>
      {
        shows.map((s) => (
          <li>
            <div>
              <strong>{s.title}</strong>
              <span>
                {c.nextEpisode} · {when.format(new Date(s.airs))}
              </span>
            </div>
            <span class="mute">
              <svg viewBox="0 0 24 24">
                <path d="M9.5 19.5a2.6 2.6 0 0 0 5 0M7 7.6A5.5 5.5 0 0 0 6.5 10v4.5L5 16.8h11.5M9.4 4.9A5.5 5.5 0 0 1 17.5 10v3.6M4 4l16 16" />
              </svg>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <!-- SF Symbols bell.badge: the badge sits in a notch cut from the bell. -->
    <mask id="bell-notch">
      <rect width="24" height="24" fill="#fff" />
      <circle cx="18" cy="5.5" r="4.8" fill="#000" />
    </mask>
    <symbol id="bell-badge" viewBox="0 0 24 24">
      <path
        mask="url(#bell-notch)"
        d="M12 2.5a1.4 1.4 0 0 1 1.4 1.4v.5a6 6 0 0 1 4.6 5.8v4.3l1.6 2.2c.5.7 0 1.6-.8 1.6H5.2c-.8 0-1.3-.9-.8-1.6L6 14.5v-4.3a6 6 0 0 1 4.6-5.8v-.5A1.4 1.4 0 0 1 12 2.5zM9.6 19.5h4.8a2.4 2.4 0 0 1-4.8 0z"
      />
      <circle cx="18" cy="5.5" r="3.2" />
    </symbol>
  </svg>
</div>

<style>
  /* After the app's Airing Reminders settings card and its Manage Reminders list. */
  .card {
    width: 17rem;
    padding: 1rem;
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-2);
    font-size: 0.86rem;
    line-height: 1.35;
  }

  svg {
    flex: none;
  }

  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 2.4rem;
    aspect-ratio: 1;
    border-radius: 12px;
    background: color-mix(in oklab, var(--apricot) 20%, transparent);
    color: #f08a2c;
  }

  .tile svg {
    width: 1.3rem;
    fill: currentColor;
  }

  .head strong {
    display: block;
    font-size: 0.98rem;
    font-weight: 650;
  }

  .head p {
    margin-top: 0.1rem;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }

  .remind {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-weight: 650;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.55rem 0.3rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--apricot) 18%, transparent);
    border: 1px solid color-mix(in oklab, var(--apricot) 35%, transparent);
    color: var(--apricot-deep);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .pill svg {
    width: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .manage {
    margin: 0.9rem -0.35rem -0.35rem;
    padding: 0.7rem 0.75rem 0.2rem;
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .manage-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.55rem;
    font-weight: 650;
  }

  .manage-title svg {
    width: 1.05rem;
    fill: currentColor;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.55rem 0;
    border-top: 1px solid var(--rule);
  }

  li strong {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: 'Hiragino Sans', var(--font-body);
    font-weight: 600;
  }

  li div span {
    white-space: nowrap;
    font-size: 0.76rem;
    color: var(--ink-faint);
  }

  .mute {
    display: grid;
    place-items: center;
    width: 1.9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--vermilion) 14%, transparent);
    color: var(--vermilion);
  }

  .mute svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
