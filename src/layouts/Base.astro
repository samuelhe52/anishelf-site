---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/martian-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// The Latin files every page uses above the fold, preloaded so a first visit
// doesn't wait for the CSS to find them. They're the files the CSS points to.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import schibstedUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import martianUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url';
import {
  APP_STORE_URL,
  GITHUB_URL,
  SITE,
  htmlLang,
  locales,
  pagePath,
  ogLocale,
  strings,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  /** Page path below the locale root, such as `privacy/`. Empty for the landing page. */
  path?: string;
  /** Defaults to the landing page's title and description. */
  title?: string;
  description?: string;
  /** Set for utility pages that must not be indexed, such as the OG templates. */
  noindex?: boolean;
}

const { locale, path = '', noindex = false } = Astro.props;
const t = strings[locale];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const url = (l: Locale) => new URL(pagePath(l, path), SITE).href;
const canonical = url(locale);
const ogImage = new URL(`/og/og-${locale}.png`, SITE).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'AniShelf',
  description: t.meta.description,
  operatingSystem: 'iOS 26.0, iPadOS 26.0, macOS 26.0 (Apple silicon)',
  applicationCategory: 'EntertainmentApplication',
  inLanguage: ['en', 'zh-Hans', 'ja'],
  url: canonical,
  downloadUrl: APP_STORE_URL,
  installUrl: APP_STORE_URL,
  sameAs: [GITHUB_URL],
  image: new URL('/icon-512.png', SITE).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Samuel He', url: 'https://github.com/samuelhe52' },
};
---

<!doctype html>
<html lang={htmlLang[locale]} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    {
      [frauncesUrl, schibstedUrl, martianUrl].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={url(l)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={url('en')} />

    <meta name="theme-color" content="#f7f1e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1226" media="(prefers-color-scheme: dark)" />
    <meta name="apple-itunes-app" content="app-id=6759359144" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AniShelf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@SamuelHe89" />

    {path === '' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>

<script>
  // Load new CJK heading glyphs before displaying the next page.
  document.addEventListener('astro:before-preparation', (event) => {
    const loader = event.loader;
    event.loader = async () => {
      await loader();
      const next = event.newDocument;
      if (event.signal.aborted || next.documentElement.lang !== document.documentElement.lang) return;
      const family = { 'zh-Hans': 'Noto Serif SC', ja: 'Noto Serif JP' }[next.documentElement.lang];
      if (!family) return;
      const text = Array.from(next.querySelectorAll('h1, h2, h3, .spine .title'))
        .map((heading) => heading.textContent).join('');
      // A failed font request must not prevent navigation.
      await document.fonts.load(`700 1em "${family}"`, text).catch(() => {});
    };
  });

  const wide = matchMedia('(min-width: 1000px)');
  const syncContents = (root: Document) => {
    const toc = root.querySelector<HTMLDetailsElement>('.toc');
    if (toc) toc.open = wide.matches;
  };
  // Prepare the incoming DOM before it is displayed, not on page-load.
  document.addEventListener('astro:before-swap', (event) => {
    syncContents(event.newDocument);
    // Crossfade only between docs in the same language.
    if (event.newDocument.documentElement.lang !== document.documentElement.lang ||
        !document.querySelector('main.doc') || !event.newDocument.querySelector('main.doc')) {
      event.viewTransition.skipTransition();
    } else {
      // Keep fading content below the header, which stays in the root snapshot
      // so its backdrop and paper texture retain their normal appearance.
      document.addEventListener('astro:after-swap', () => {
        const header = document.querySelector('.top')!.getBoundingClientRect();
        const main = document.querySelector('main.doc')!.getBoundingClientRect();
        document.documentElement.style.setProperty('--doc-transition-top', `${Math.max(0, header.bottom - main.top)}px`);
      }, { once: true });
    }
    if (event.navigationType === 'traverse' || event.newDocument.documentElement.lang === document.documentElement.lang) return;
    // Language switches land at the section immediately; ordinary links still scroll smoothly.
    document.addEventListener('astro:after-swap', () => {
      document.getElementById(event.to.hash.slice(1))?.scrollIntoView({ behavior: 'instant' });
    }, { once: true });
  });
  document.addEventListener('astro:page-load', () => syncContents(document));
  wide.addEventListener('change', () => syncContents(document));
</script>
